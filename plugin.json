{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "blender-design",
  "version": "0.14.1",
  "description": "受控 Blender 操作，含里程碑截图、事务回滚、白模预演与多格式校验导出。",
  "author": {
    "name": "Full Stack Skills / PartMe.AI",
    "url": "https://github.com/partme-ai"
  },
  "homepage": "https://github.com/full-aigc-plugins/blender-design-plugin",
  "repository": "https://github.com/full-aigc-plugins/blender-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "blender",
    "3d-design",
    "modeling",
    "animation",
    "export",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Blender Design · 3D Modeling",
        "shortDescription": "Modeling, rigging, materials, animation, rendering and export",
        "longDescription": "Controls Blender through a guarded local Harness in non-invasive managed or Connector mode, with structured scene operations, milestone screenshots, transaction rollback, and verified multi-format exports.",
        "developerName": "Full Stack Skills / PartMe.AI",
        "category": "Creativity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "websiteURL": "https://github.com/full-aigc-plugins/blender-design-plugin",
        "privacyPolicyURL": "https://github.com/full-aigc-plugins/blender-design-plugin/blob/main/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/full-aigc-plugins/blender-design-plugin/blob/main/TERMS.md",
        "defaultPrompt": [
          "Create a Blender scene from this idea and show milestone previews",
          "Connect to my open Blender project and continue the design safely",
          "Export the approved Blender design and verify every output file"
        ],
        "brandColor": "#E87D0D",
        "composerIcon": "./assets/official-logo.png",
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "screenshots": [],
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "Blender Design"
    }
  }
}
